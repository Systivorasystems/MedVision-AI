{
  "name": "medvision-ai",
  "version": "0.1.0",
  "private": true,
  "description": "MedVision AI: clinician-facing medical imaging research and decision-support platform (research use only).",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev:web": "pnpm --filter @medvision/web dev",
    "build:web": "pnpm --filter @medvision/web build",
    "lint:web": "pnpm --filter @medvision/web lint",
    "typecheck:web": "pnpm --filter @medvision/web typecheck"
  }
}
