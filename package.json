{
  "name": "medvision-ai",
  "version": "0.1.0",
  "private": true,
  "description": "MedVision AI: clinician-facing medical imaging research and decision-support platform (research use only).",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev:web": "pnpm --filter @medvision/web dev",
    "build:web": "pnpm --filter @medvision/web build",
    "lint:web": "pnpm --filter @medvision/web lint",
    "typecheck:web": "pnpm --filter @medvision/web typecheck",
    "dev:api": "pnpm --filter @medvision/api dev",
    "build:api": "pnpm --filter @medvision/api build",
    "typecheck:api": "pnpm --filter @medvision/api typecheck",
    "test:api": "pnpm --filter @medvision/api test",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate --no-hints",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:up": "docker compose -f infrastructure/docker-compose.yml --env-file .env up -d",
    "db:down": "docker compose -f infrastructure/docker-compose.yml --env-file .env down"
  },
  "devDependencies": {
    "dotenv": "^18.0.9",
    "prisma": "7.10.1"
  }
}
