# MedVision AI: example environment variables
# Copy to .env and fill in real values. NEVER commit .env.

NODE_ENV=development

# Web (apps/web): only NEXT_PUBLIC_* values are visible in the browser
NEXT_PUBLIC_API_URL=http://localhost:4000

# API (apps/api)
API_PORT=4000
DATABASE_URL=postgresql://medvision:change_me@127.0.0.1:5433/medvision
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
CORS_ORIGIN=http://localhost:3000

# AI service (apps/ai-service): used in a later phase
AI_SERVICE_URL=http://localhost:8000

# Landing page hero video (optional). Put files in apps/web/public/ and set these in apps/web/.env.local
# NEXT_PUBLIC_HERO_VIDEO_SRC=/videos/hero.mp4
# NEXT_PUBLIC_HERO_POSTER_SRC=/images/hero-poster.jpg

# Logging (API): fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Local PostgreSQL (docker compose). Development only: use a strong password anywhere else.
POSTGRES_USER=medvision
POSTGRES_PASSWORD=change_me
POSTGRES_DB=medvision
